contract Ownable {
    event AutoGenerated_mapping_Ownable(string mapping_origin, string mapping_cache);
    address public owner;

    function Ownable() {
        owner = msg.sender;
    }

    modifier onlyOwner() {
        if (!(msg.sender == owner)) {
            revert();
        }
        _;
    }

    function transferOwnership(address originNewOwner) onlyOwner {
        if (!(msg.sender == owner)) {
            revert();
        }
        if (originNewOwner != address(0x0)) {
            owner = originNewOwner;
        }
    }
}

