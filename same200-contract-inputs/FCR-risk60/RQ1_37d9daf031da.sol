library SafeMath {
    event AutoGenerated_mapping_SafeMath(string mapping_origin, string mapping_cache);

    function mul(uint256 a, uint256 b) internal pure returns (uint256 c) {
        if (a == 0) {
            return 0;
        }
        c = a * b;
        if (!(c / a == b)) {
            revert();
        }
        return c;
    }

    function div(uint256 a, uint256 b) internal pure returns (uint256) {
        return a / b;
    }

    function sub(uint256 a, uint256 b) internal pure returns (uint256) {
        if (!(b <= a)) {
            revert();
        }
        return a - b;
    }

    function add(uint256 a, uint256 b) internal pure returns (uint256 c) {
        c = a + b;
        if (!(c >= a)) {
            revert();
        }
        return c;
    }
}

contract Ownable {
    event AutoGenerated_mapping_Ownable(string mapping_origin, string mapping_cache);
    address public owner;
    event OwnershipTransferred(address previousOwner, address originNewOwner);
    modifier onlyOwner() {
        if (!(msg.sender == owner || msg.sender == address(this))) {
            revert();
        }
        _;
    }

    constructor() public {
        owner = msg.sender;
    }

    function transferOwnership(address _newOwner) public onlyOwner {
        if (!(msg.sender == owner || msg.sender == address(this))) {
            revert();
        }
        {
            if (!(_newOwner != address(0x0))) {
                revert();
            }
            emit OwnershipTransferred(owner, _newOwner);
            owner = _newOwner;
        }
    }

    function _transferOwnership(address _newOwner) internal {
        if (!(_newOwner != address(0x0))) {
            revert();
        }
        emit OwnershipTransferred(owner, _newOwner);
        owner = _newOwner;
    }
}

contract Pausable is Ownable {
    event AutoGenerated_mapping_Pausable(string mapping_origin, string mapping_cache);
    event Pause(bool isPause);
    bool public paused = false;
    modifier whenNotPaused() {
        if (!(!paused)) {
            revert();
        }
        _;
    }
    modifier whenPaused() {
        if (!(paused)) {
            revert();
        }
        _;
    }

    function pause() public onlyOwner whenNotPaused {
        if (!(msg.sender == owner || msg.sender == address(this))) {
            revert();
        }
        if (!(!paused)) {
            revert();
        }
        paused = true;
        emit Pause(paused);
    }

    function unpause() public onlyOwner whenPaused {
        if (!(msg.sender == owner || msg.sender == address(this))) {
            revert();
        }
        if (!(paused)) {
            revert();
        }
        paused = false;
        emit Pause(paused);
    }
}

