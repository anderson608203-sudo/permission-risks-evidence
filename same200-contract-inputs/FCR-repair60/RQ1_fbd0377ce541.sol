pragma solidity ^0.4.25;

contract Utils {
    event AutoGenerated_mapping_Utils(string mapping_origin, string mapping_cache);
    modifier validAddress(address _address) {
        if (!(_address != address(0x0))) {
            revert();
        }
        _;
    }

    function safeAdd(uint256 _x, uint256 _y) internal pure returns (uint256) {
        uint256 _z = _x + _y;
        if (!(_z >= _x)) {
            revert();
        }
        return _z;
    }

    function safeSub(uint256 _x, uint256 _y) internal pure returns (uint256) {
        if (!(_x >= _y)) {
            revert();
        }
        return _x - _y;
    }

    function safeMul(uint256 _x, uint256 _y) internal pure returns (uint256) {
        uint256 _z = _x * _y;
        if (!(_x == 0 || _z / _x == _y)) {
            revert();
        }
        return _z;
    }

    function safeDiv(uint256 _x, uint256 _y) internal pure returns (uint256) {
        if (!(_y != 0)) {
            revert();
        }
        uint256 _z = _x / _y;
        if (!(_x == _y * _z + (_x % _y))) {
            revert();
        }
        return _z;
    }
}

contract Ownable {
    event AutoGenerated_mapping_Ownable(string mapping_origin, string mapping_cache);
    address public owner;

    function Ownable() public {
        owner = msg.sender;
    }

    modifier onlyOwner() {
        if (!(msg.sender == owner)) {
            revert();
        }
        _;
    }

    function transferOwnership(address originNewOwner) public onlyOwner {
        if (!(msg.sender == owner)) {
            revert();
        }
        if (!(originNewOwner != address(0x0))) {
            revert();
        }
        owner = originNewOwner;
    }
}

