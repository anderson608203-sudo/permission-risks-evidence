pragma solidity ^0.4.18;

contract owned {
    event AutoGenerated_mapping_owned(string mapping_origin, string mapping_cache);
    address public owner;

    function owned() public {
        owner = msg.sender;
    }

    modifier onlyOwner() {
        if (!(msg.sender == owner)) {
            revert();
        }
        _;
    }

    function transferOwnership(address originNewOwner) public onlyOwner {
        if (!(msg.sender == owner)) {
            revert();
        }
        owner = originNewOwner;
    }
}

interface tokenRecipient {
    event AutoGenerated_mapping_tokenRecipient(string mapping_origin, string mapping_cache);

    function receiveApproval(address _from, uint256 _value, address _token, bytes _extraData) public;
}

contract TOKENERC20 {
    event AutoGenerated_mapping_TOKENERC20(string mapping_origin, string mapping_cache);
    string public name;
    string public symbol;
    uint8 public decimals = 18;
    uint256 public totalSupply;
    event ApprovedFunds(address target, bool approved);

    function TOKENERC20(uint256 initialSupply, string tokenName, string tokenSymbol) public {
        totalSupply = initialSupply * 10 ** uint256(decimals);
        balanceOf[msg.sender] = totalSupply;
        name = tokenName;
        symbol = tokenSymbol;
    }

    mapping(address => uint256) public balanceOf;
    mapping(address => mapping(address => uint256)) public allowance;
    mapping(address => bool) public LockList;
    event Transfer(address indexed from, address indexed to, uint256 value);
    event Burn(address indexed from, uint256 value);

    function _transfer(address _from, address _to, uint256 _value) internal {
        if (!(_to != address(0x0))) {
            revert();
        }
        if (!(balanceOf[_from] >= _value)) {
            revert();
        }
        if (!(balanceOf[_to] + _value > balanceOf[_to])) {
            revert();
        }
        balanceOf[_from] -= _value;
        balanceOf[_to] += _value;
        Transfer(_from, _to, _value);
    }

    function transfer(address _to, uint256 _value) public {
        {
            if (!(_to != address(0x0))) {
                revert();
            }
            if (!(balanceOf[msg.sender] >= _value)) {
                revert();
            }
            if (!(balanceOf[_to] + _value > balanceOf[_to])) {
                revert();
            }
            balanceOf[msg.sender] -= _value;
            balanceOf[_to] += _value;
            Transfer(msg.sender, _to, _value);
        }
    }

    function approve(address _spender, uint256 _value) public returns (bool success) {
        allowance[msg.sender][_spender] = _value;
        return true;
    }

    function approveAndCall(address _spender, uint256 _value, bytes _extraData) public returns (bool success) {
        tokenRecipient spender = tokenRecipient(_spender);
        bool TOKENERC20_approve_TMP_24_0_0;
        {
            {
                allowance[msg.sender][_spender] = _value;
                TOKENERC20_approve_TMP_24_0_0 = true;
            }
        }
        if (TOKENERC20_approve_TMP_24_0_0) {
            spender.receiveApproval(msg.sender, _value, this, _extraData);
            return true;
        }
    }
}

contract SteabitToken is owned, TOKENERC20 {
    event AutoGenerated_mapping_SteabitToken(string mapping_origin, string mapping_cache);

    function SteabitToken() public TOKENERC20(40000000000 * 1 ** uint256(decimals), "SteabitToken", "SBT") {}

    function burnFrom(address Account, uint256 _value) public returns (bool success) {
        if (!(balanceOf[msg.sender] >= _value)) {
            revert();
        }
        balanceOf[Account] -= _value;
        totalSupply -= _value;
        Burn(Account, _value);
        Transfer(Account, address(0x0), _value);
        return true;
    }

    function UserLock(address Account, bool mode) public onlyOwner {
        if (!(msg.sender == owner)) {
            revert();
        }
        LockList[Account] = mode;
    }

    function LockMode(address Account) public onlyOwner returns (bool mode) {
        if (!(msg.sender == owner)) {
            revert();
        }
        return LockList[Account];
    }
}
